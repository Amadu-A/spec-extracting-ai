DATA_DIRECTORY=data
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=500
MAX_SELECTED_PAGES=100
RENDER_DPI=160
MAX_IMAGE_PIXELS=6000000
MAX_PAGE_POINTS=20000
MAX_STREAM_CHARS=2000000
