APP_PORT=8083
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=specification
DATABASE_USER=specification
DATABASE_PASSWORD=
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_VHOST=specification
RABBITMQ_USER=specification
RABBITMQ_PASSWORD=
RABBITMQ_QUEUE=specification.extractions
SHARED_VLM_BASE_URL=http://shared-vlm:8000/v1
